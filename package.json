{
  "name": "@qadanm/opencode-smart-router",
  "version": "0.3.0",
  "description": "Subscription-aware model routing for OpenCode: nested usage windows, multi-pool credit accounting, and context policy.",
  "keywords": [
    "opencode",
    "plugin",
    "router",
    "llm",
    "quota",
    "openrouter",
    "ai",
    "coding-agent"
  ],
  "homepage": "https://github.com/qadanm/opencode-smart-router#readme",
  "bugs": {
    "url": "https://github.com/qadanm/opencode-smart-router/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qadanm/opencode-smart-router.git"
  },
  "author": "Moe Qadan",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./allowance": "./src/allowance.ts",
    "./tui": "./dist/tui.js",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "dist",
    "src",
    "scripts/install.sh",
    "scripts/uninstall.sh",
    "install",
    "config.example.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "docs/ARCHITECTURE.md",
    "docs/INSTALL.md",
    "docs/LIMITATIONS.md",
    "docs/MODELS.md",
    "docs/OPENDESIGN-INTEGRATION.md",
    "docs/SHARED-CORE.md",
    "docs/QA.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "build:server": "esbuild src/index.ts --bundle --format=esm --platform=node --target=node22 --external:@opencode/plugin --external:@opencode/plugin/* --outfile=dist/index.js --legal-comments=none",
    "build:allowance": "esbuild src/allowance.ts --bundle --format=esm --platform=neutral --target=node20 --outfile=dist/allowance.js --legal-comments=none",
    "build:gui": "vite build --config vite.gui.config.ts",
    "build:tui": "esbuild src/tui/index.tsx --bundle --format=esm --platform=node --target=node22 --external:@opencode/plugin --external:@opencode/plugin/* --external:@opentui/core --external:@opentui/solid --external:solid-js --outfile=dist/tui.js --legal-comments=none",
    "build:all": "npm run build:server && npm run build:allowance && npm run build:gui && npm run build:tui",
    "mutate": "python3 scripts/mutate.py",
    "verify": "bash scripts/cleanroom-verify.sh",
    "prepublishOnly": "npm run check && npm run build:server"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "solid-js": "^1.9.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  }
}
